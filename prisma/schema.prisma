generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sorteo {
  idSorteo      String   @id @map("id_sorteo")
  tipoJuego     Int      @map("tipo_juego")
  anoEmision    Int      @map("ano_emision")
  anoCompleto   Int      @map("ano_completo")
  numeroSorteo  Int      @map("numero_sorteo")
  nombreSorteo  String   @map("nombre_sorteo")
  precioCentimos Int     @map("precio_unitario_centimos")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  boletos Boleto[]
  origenes Origen[]

  @@unique([tipoJuego, anoCompleto, numeroSorteo])
  @@map("sorteos")
}

model Origen {
  idOrigen        String   @id @map("id_origen")
  idSorteo        String?  @map("id_sorteo")
  idReceptorAdmin String?  @map("id_receptor_admin")
  tipoOrigen      String   @map("tipo_origen")
  fechaHoraCarga  DateTime @default(now()) @map("fecha_hora_carga")
  fechaEmision    DateTime? @map("fecha_emision")
  totalNumeros    Int      @default(0) @map("total_numeros")
  totalSeries     Int      @default(0) @map("total_series")
  totalBilletes   Int      @default(0) @map("total_billetes")
  pdfPath         String?  @map("pdf_path")
  pdfChecksum     String?  @unique @map("pdf_checksum")
  deletedAt       DateTime? @map("deleted_at")

  sorteo Sorteo? @relation(fields: [idSorteo], references: [idSorteo], onDelete: Restrict)
  boletos Boleto[] @relation("AltaBoleto")
  boletosCedidos Boleto[] @relation("CesionBoleto")

  @@index([idSorteo])
  @@map("origenes")
}

/// Un décimo individual. Reúne su inventario, su venta y su cesión:
/// - `estado`: `disponible`, `vendido` o `cedido` (excluyentes entre sí).
/// - `idOrigen` nulo: el boleto aún no se ha recibido (su albarán no está cargado),
///   por ejemplo si se vende o se cede antes de cargar el albarán de entrada.
/// - Una venta anulada deja el boleto `disponible` conservando `fechaHoraVenta`,
///   `fechaHoraAnulacion` y `motivoAnulacion` hasta que se vuelva a vender o ceder.
model Boleto {
  idBoleto           String    @id @map("id_boleto")
  idSorteo           String    @map("id_sorteo")
  idOrigen           String?   @map("id_origen")
  numeroJugado       String    @map("numero_jugado")
  serie              String
  fraccion           String
  digitosControl     String    @map("digitos_control")
  codigoBarrasRaw    String    @map("codigo_barras_raw")
  fechaHoraRegistro  DateTime  @default(now()) @map("fecha_hora_registro")
  estado             String    @default("disponible")
  fechaHoraVenta     DateTime? @map("fecha_hora_venta")
  fechaHoraAnulacion DateTime? @map("fecha_hora_anulacion")
  motivoAnulacion    String?   @map("motivo_anulacion")
  fechaHoraCesion    DateTime? @map("fecha_hora_cesion")
  idOrigenCesion     String?   @map("id_origen_cesion")

  sorteo Sorteo @relation(fields: [idSorteo], references: [idSorteo], onDelete: Restrict)
  origen Origen? @relation("AltaBoleto", fields: [idOrigen], references: [idOrigen], onDelete: Restrict)
  origenCesion Origen? @relation("CesionBoleto", fields: [idOrigenCesion], references: [idOrigen], onDelete: Restrict)

  @@unique([idSorteo, numeroJugado, serie, fraccion])
  @@index([idOrigen])
  @@index([idOrigenCesion])
  @@index([estado])
  @@index([fechaHoraVenta])
  @@map("boletos")
}
